{
  "buildCommand": "npm run build && node scripts/build-vercel.mjs",
  "outputDirectory": "dist/client",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/pages/estados/sao-paulo.html",
      "destination": "/pages/estados/sao-paulo",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pages/estados/sao-paulo",
      "destination": "/pages/estados/sao-paulo.html.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
